hermes.seloraos.online {
	reverse_proxy 127.0.0.1:9119
}

http://80.225.246.130 {
	root * /srv/straredgex/dist
	encode gzip zstd
	try_files {path} /index.html
	file_server
}

raptwin.seloraos.online {
	# Digital Twin API. handle_path strips the /api prefix, matching the
	# dev-server proxy so the same frontend build works in both places.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8080 {
			# /api/stream is Server-Sent Events: disable response buffering,
			# otherwise events would be delivered in batches instead of live.
			flush_interval -1
		}
	}

	# Static SPA. encode lives here rather than at site level so it never
	# touches the event stream above.
	handle {
		encode gzip zstd
		root * /srv/raptwin/web/dist

		# Security & SEO performance headers
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}

		# Asset caching headers for high PageSpeed performance scores
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /robots.txt Cache-Control "public, max-age=86400"
		header /sitemap.xml Cache-Control "public, max-age=86400"
		header /og-image.* Cache-Control "public, max-age=604800"

		try_files {path} /index.html
		file_server
	}
}
